msgstr "الصفحة"

msgid "No matching events are published yet."
msgstr "لا توجد فعاليات منشورة مطابقة حالياً."

msgid "Try another filter or return later. New events appear only after editorial review."
msgstr "جرّب خيارات تصفية أخرى أو عُد لاحقاً. لا تظهر الفعاليات الجديدة إلا بعد مراجعتها واعتماد نشرها."

msgid "In person"
msgstr "حضوري"

msgid "Online"
msgstr "عبر الإنترنت"

msgid "Hybrid"
msgstr "حضوري وعبر الإنترنت"

msgid "Conference"
msgstr "مؤتمر"

msgid "Exhibition"
msgstr "معرض"

msgid "Workshop"
msgstr "ورشة عمل"

msgid "Webinar"
msgstr "ندوة عبر الإنترنت"

msgid "Meetup"
msgstr "لقاء مجتمعي"

msgid "Scheduled"
msgstr "مجدولة"

msgid "Postponed"
msgstr "مؤجلة"

msgid "Cancelled"
msgstr "ملغاة"

msgid "Enable JavaScript to use the video player."
msgstr "فعّل JavaScript لاستخدام مشغّل الفيديو."

msgid "Loading playlist…"
msgstr "جارٍ تحميل قائمة التشغيل…"

msgid "YouTube loads only when you choose to watch. Playback depends on the video's availability and embedding permissions. Close to stop playback."
msgstr "لا يتم تحميل محتوى يوتيوب إلا عند اختيار المشاهدة. يعتمد التشغيل على إتاحة الفيديو والسماح بتضمينه. أغلق النافذة لإيقاف التشغيل."

msgid "Event details"
msgstr "تفاصيل الفعالية"

msgid "Event type"
msgstr "نوع الفعالية"

msgid "Organizer"
msgstr "الجهة المنظمة"

msgid "Event status"
msgstr "حالة الفعالية"

msgid "Arabic description"
msgstr "الوصف بالعربية"

msgid "Event schedule"
msgstr "مواعيد الفعالية"

msgid "Start date"
msgstr "تاريخ البداية"

msgid "End date"
msgstr "تاريخ النهاية"

msgid "Local start time"
msgstr "وقت البداية المحلي"

msgid "Local end time"
msgstr "وقت النهاية المحلي"

msgid "Dates only"
msgstr "التواريخ فقط"

msgid "Venue and official website"
msgstr "مكان الانعقاد والموقع الرسمي"

msgid "City"
msgstr "المدينة"

msgid "Venue"
msgstr "مكان الانعقاد"

msgid "Official event URL"
msgstr "الرابط الرسمي للفعالية"

msgid "Publication"
msgstr "النشر"

msgid "Publish"
msgstr "نشر"

msgid "Unpublish"
msgstr "إلغاء النشر"

msgid "Relevant to the Middle East audience"
msgstr "تُهم جمهور الشرق الأوسط"

msgid "Source and integration reference"
msgstr "المصدر ومرجع التكامل"

msgid "Source provider"
msgstr "مزود المصدر"

msgid "External event ID"
msgstr "معرّف الفعالية لدى المصدر"

msgid "Source identity"
msgstr "هوية المصدر"

msgid "Source URL"
msgstr "رابط المصدر"

msgid "Internal notes"
msgstr "ملاحظات داخلية"

msgid "Start UTC"
msgstr "البداية بالتوقيت العالمي"

msgid "End UTC"
msgstr "النهاية بالتوقيت العالمي"

msgid "IANA zone, for example Asia/Riyadh, Asia/Dubai or Africa/Cairo."
msgstr "منطقة زمنية وفق IANA، مثل Asia/Riyadh أو Asia/Dubai أو Africa/Cairo."

msgid "Complete the required event details within the field limits."
msgstr "أكمل بيانات الفعالية المطلوبة مع مراعاة الحد الأقصى لطول الحقول."

msgid "Enter valid event dates."
msgstr "أدخل تواريخ صحيحة للفعالية."

msgid "Enter valid local start and end times."
msgstr "أدخل وقتي بداية ونهاية صحيحين بالتوقيت المحلي."

msgid "This local time does not exist because of a clock change."
msgstr "هذا الوقت المحلي غير صالح بسبب تغيير التوقيت."

msgid "This local time is ambiguous because of a clock change."
msgstr "هذا الوقت المحلي يتكرر بسبب تغيير التوقيت؛ اختر وقتاً غير ملتبس."

msgid "Select a valid topic, type, format and event status."
msgstr "اختر موضوعاً ونوعاً وطريقة حضور وحالة صحيحة للفعالية."

msgid "Country, city and venue are required for in-person and hybrid events."
msgstr "يجب تحديد الدولة والمدينة ومكان الانعقاد للفعاليات الحضورية والمختلطة."

msgid "Enter a valid IANA time zone, such as Asia/Riyadh or Africa/Cairo."
msgstr "أدخل منطقة زمنية صحيحة وفق IANA، مثل Asia/Riyadh أو Africa/Cairo."

msgid "The event end must be after its start."
msgstr "يجب أن تنتهي الفعالية بعد بدايتها."

msgid "The source verification date cannot be in the future."
msgstr "لا يمكن أن يكون تاريخ التحقق من المصدر في المستقبل."

msgid "Verify the source and enter its verification date before publishing."
msgstr "تحقق من المصدر وأدخل تاريخ التحقق قبل النشر."

msgid "Event photos"
msgstr "صور الفعالية"

msgid "Cover image"
msgstr "صورة الغلاف"

msgid "Cover caption"
msgstr "وصف صورة الغلاف"

msgid "Arabic cover caption"
msgstr "وصف صورة الغلاف بالعربية"

msgid "Photo gallery"
msgstr "معرض الصور"

msgid "Gallery images"
msgstr "صور المعرض"

msgid "Event image"
msgstr "صورة الفعالية"

msgid "Image caption"
msgstr "وصف الصورة"

msgid "Arabic image caption"
msgstr "وصف الصورة بالعربية"

msgid "Upload only images you may publish. Public image files are accessible even before the event is published."
msgstr "ارفع فقط الصور المسموح لك بنشرها. تكون ملفات الصور العامة متاحة حتى قبل نشر الفعالية."

msgid "Public from upload, including on draft events. JPG, PNG, WebP or GIF; maximum 5 MB."
msgstr "تكون الصورة عامة منذ رفعها، حتى في الفعاليات المسودة. الصيغ: JPG أو PNG أو WebP أو GIF، بحد أقصى 5 ميجابايت."

msgid "Add up to 8 photos. Row order controls display order. Without a cover, the first photo becomes the cover."
msgstr "أضف حتى 8 صور. يحدد ترتيب الصفوف ترتيب العرض. عند عدم تحديد غلاف، تُستخدم الصورة الأولى كغلاف."

msgid "Paste a public website domain or URL. Saved as HTTPS. Public ERP Developers pages are allowed; private and administrative addresses are not."
msgstr "الصق اسم نطاق أو رابط موقع عام. يُحفظ الرابط بصيغة HTTPS. تُقبل صفحات ERP Developers العامة، ولا تُقبل العناوين الخاصة أو الإدارية."

msgid "Optional public source link. Leave empty when it is the same as the official event page."
msgstr "رابط عام اختياري للمصدر. اتركه فارغاً إذا كان هو نفسه الرابط الرسمي للفعالية."

msgid "{0}: {1}"
msgstr "{0}: {1}"

msgid "Enter a public website URL."
msgstr "أدخل رابط موقع عام."

msgid "Enter a valid website URL without control characters or backslashes."
msgstr "أدخل رابط موقع صحيحاً دون محارف تحكم أو شرطات مائلة عكسية."

msgid "The website hostname or port is invalid."
msgstr "اسم مضيف الموقع أو المنفذ غير صحيح."

msgid "Use HTTPS or paste the public website domain."
msgstr "استخدم HTTPS أو الصق اسم نطاق الموقع العام."

msgid "Website URLs cannot contain a username or password."
msgstr "لا يجوز أن يحتوي رابط الموقع على اسم مستخدم أو كلمة مرور."

msgid "Use the standard HTTPS website port."
msgstr "استخدم منفذ HTTPS القياسي للموقع."

msgid "The website hostname is invalid."
msgstr "اسم مضيف الموقع غير صحيح."

msgid "Use a public domain name, not an IP address."
msgstr "استخدم اسم نطاق عام، وليس عنوان IP."

msgid "Enter a valid public domain, for example www.example.com."
msgstr "أدخل اسم نطاق عام صحيحاً، مثل www.example.com."

msgid "Local and private-network hostnames are not allowed."
msgstr "أسماء المضيفين المحلية والخاصة بالشبكات الداخلية غير مسموح بها."

msgid "Use an external website for this resource."
msgstr "استخدم موقعاً خارجياً لهذا المورد."

msgid "Use a public page, not a private or administrative route."
msgstr "استخدم صفحة عامة، وليس مساراً خاصاً أو إدارياً."

msgid "The URL contains an invalid percent-encoded character."
msgstr "يحتوي الرابط على محرف غير صحيح بترميز النسبة المئوية."

msgid "The website URL is too long."
msgstr "رابط الموقع أطول من الحد المسموح."

msgid "Upload a public JPG, PNG, WebP or GIF using Attach Image."
msgstr "ارفع صورة عامة بصيغة JPG أو PNG أو WebP أو GIF باستخدام إرفاق صورة."

msgid "The event image path is invalid."
msgstr "مسار صورة الفعالية غير صحيح."

msgid "Event images must be public uploads under /files/, not private files or external URLs."
msgstr "يجب أن تكون صور الفعالية ملفات عامة مرفوعة ضمن /files/، وليست ملفات خاصة أو روابط خارجية."

msgid "Image captions must be plain text of at most 240 characters."
msgstr "يجب أن يكون وصف الصورة نصاً عادياً لا يتجاوز 240 محرفاً."

msgid "Choose a public image upload; private files are never made public automatically."
msgstr "اختر صورة مرفوعة كملف عام؛ لا تُحوّل الملفات الخاصة إلى عامة تلقائياً."

msgid "The uploaded image file is missing or outside the public files folder."
msgstr "ملف الصورة المرفوعة غير موجود أو يقع خارج مجلد الملفات العامة."

msgid "Each event image must be no larger than 5 MB."
msgstr "يجب ألا يتجاوز حجم كل صورة للفعالية 5 ميجابايت."

msgid "The file contents do not match a supported image format."
msgstr "محتوى الملف لا يطابق إحدى صيغ الصور المدعومة."

msgid "Resize the event image to no more than 24 megapixels."
msgstr "قلّل أبعاد صورة الفعالية لتكون بدقة لا تتجاوز 24 ميجابكسل."

msgid "The uploaded file is not a valid supported image."
msgstr "الملف المرفوع ليس صورة صحيحة بصيغة مدعومة."

msgid "Add no more than 8 gallery images per event."
msgstr "أضف بحد أقصى 8 صور في معرض كل فعالية."

msgid "The event gallery contains the same image more than once."
msgstr "يحتوي معرض الفعالية على الصورة نفسها أكثر من مرة."

msgid "Choose an existing public image up to 5 MB; private or missing files cannot be displayed."
msgstr "اختر صورة عامة موجودة بحجم لا يتجاوز 5 ميجابايت؛ لا يمكن عرض الملفات الخاصة أو غير الموجودة."

