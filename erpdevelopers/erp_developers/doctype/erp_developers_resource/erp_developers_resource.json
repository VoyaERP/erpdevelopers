 "fields": [
  {
   "fieldname": "summary_section",
   "fieldtype": "Section Break",
   "label": "Knowledge & advice"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "title_ar",
   "fieldtype": "Data",
   "label": "Arabic Title"
  },
  {
   "fieldname": "topic",
   "fieldtype": "Select",
   "label": "Topic",
   "reqd": 1,
   "in_list_view": 1,
   "options": "ERP & Business Applications\nSolution Architecture\nDeveloper Practices\nAI & Data\nCloud & Security\nDigital Transformation"
  },
  {
   "fieldname": "source_kind",
   "fieldtype": "Select",
   "label": "Content Type",
   "reqd": 1,
   "default": "External Source",
   "options": "External Source\nOriginal Article",
   "in_list_view": 1
  },
  {
   "fieldname": "col_2",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "summary",
   "fieldtype": "Small Text",
   "label": "Summary",
   "reqd": 1
  },
  {
   "fieldname": "editorial_note",
   "fieldtype": "Small Text",
   "label": "Our Advice",
   "reqd": 1
  },
  {
   "fieldname": "language",
   "fieldtype": "Select",
   "label": "Language",
   "default": "English",
   "options": "English\nArabic\nOther"
  },
  {
   "fieldname": "source_section",
   "fieldtype": "Section Break",
   "label": "Source and publication"
  },
  {
   "fieldname": "external_url",
   "fieldtype": "Data",
   "label": "External HTTPS URL",
   "depends_on": "eval:doc.source_kind=='External Source'"
  },
  {
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Original Source Name",
   "depends_on": "eval:doc.source_kind=='External Source'"
  },
  {
   "fieldname": "web_page",
   "fieldtype": "Link",
   "label": "Original Frappe Web Page",
   "options": "Web Page",
   "depends_on": "eval:doc.source_kind=='Original Article'"
  },
  {
   "fieldname": "source_col",
   "fieldtype": "Column Break",
   "label": ""
  },
  {
   "fieldname": "published",
   "fieldtype": "Check",
   "label": "Published",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Display Order",
   "default": "100"
  }
 ],
 "permissions": [
